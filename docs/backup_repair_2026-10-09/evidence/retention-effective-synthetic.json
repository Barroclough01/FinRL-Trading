{
  "retention": {
    "keepLatest": 3,
    "keepHourly": 0,
    "keepDaily": 7,
    "keepWeekly": 4,
    "keepMonthly": 3,
    "keepAnnual": 0,
    "ignoreIdenticalSnapshots": false
  },
  "files": {
    "ignoreDotFiles": [
      ".kopiaignore"
    ]
  },
  "errorHandling": {
    "ignoreFileErrors": false,
    "ignoreDirectoryErrors": false,
    "ignoreUnknownTypes": true
  },
  "scheduling": {
    "runMissed": true
  },
  "compression": {
    "compressorName": "zstd"
  },
  "metadataCompression": {
    "compressorName": "zstd-fastest"
  },
  "splitter": {},
  "actions": {},
  "osSnapshots": {
    "volumeShadowCopy": {
      "enable": 0
    }
  },
  "logging": {
    "directories": {
      "snapshotted": 5,
      "ignored": 5
    },
    "entries": {
      "snapshotted": 0,
      "ignored": 5,
      "cacheHit": 0,
      "cacheMiss": 0
    }
  },
  "upload": {
    "maxParallelSnapshots": 1,
    "parallelUploadAboveSize": 2147483648
  }
}