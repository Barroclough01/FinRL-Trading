{
  "contract_version": 1,
  "observation_space": [
    "recent_returns",
    "volatility",
    "covariance_features",
    "regime_state",
    "group_strength_metrics",
    "benchmark_state",
    "fundamental_features",
    "current_holdings",
    "cash_weight",
    "realized_drift"
  ],
  "action_space": "target_portfolio_weights",
  "reward_function": {
    "name": "risk_adjusted_weighted_return",
