  },
  "transaction_cost_model": {
    "name": "linear_pct_notional",
    "description": "Apply a linear transaction cost based on notional turnover.",
    "cost_rate": 0.001
  },
  "turnover_penalty": 0.01,
  "drawdown_penalty": 0.02,
  "train_eval_split": {
    "type": "walk_forward",
    "minimum_windows": 5,
    "minimum_days_per_window": 20
  },
  "walk_forward_windows": {
    "enabled": true,
    "minimum_windows": 5,
    "minimum_days_per_window": 20
  },
  "model_artifact_metadata": {
    "required": [
      "model_name",
      "seed",
      "train_window",
      "eval_window",
      "config_hash",
      "metrics_snapshot"
    ]
  },
  "acceptance_gate": {
    "minimum_sharpe": 0.8,
    "maximum_drawdown": -0.3,
    "minimum_annualized_return": 0.1,
    "maximum_turnover": 0.35,
    "minimum_improvement_vs_spy": 0.0,
    "minimum_improvement_vs_qqq": 0.0
  }
